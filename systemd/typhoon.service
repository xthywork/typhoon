[Unit]
Description=Typhoon official weather HTTP service

[Service]
Type=simple
WorkingDirectory=%h/typhoon
ExecStart=/usr/bin/python3 -u %h/typhoon/server.py --bind 0.0.0.0 --port 18765
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=90s
UMask=0077
NoNewPrivileges=yes
SyslogIdentifier=typhoon

[Install]
WantedBy=default.target
